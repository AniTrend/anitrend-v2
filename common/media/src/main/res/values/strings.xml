    <string name="label_carousel_recently_added_manga">Recently Added • Manga</string>
    <!-- Carousel description for recently added manga -->
    <string name="label_carousel_recently_added_manga_description">Manga that has been recently added.</string>


    <!-- Label for the user's own rating of the media -->
    <string name="label_media_score_section_your_rating">Your rating</string>
    <!-- Suffix shown after a number: e.g., "123 ratings" -->
    <string name="label_media_score_section_popularity_footer_suffix">ratings</string>
    <!-- Placeholder dash when no rating is available; not translatable -->
    <string name="placeholder_media_score_section_rating" translatable="false">—</string>
    <!-- Label for community-wide score/section -->
    <string name="label_media_score_section_community">Community</string>

    <!-- Action to navigate to full list of rankings -->
    <string name="label_media_rank_section_show_all_rankings">Show all rankings</string>
    <!-- Section title for rankings -->
    <string name="label_media_rank_section_title">Rankings</string>
    <!-- Supporting copy for the rankings sheet explaining the insight-focused list -->
    <string name="label_media_rank_sheet_subtitle">Popularity and score highlights for this title.</string>
    <!-- Label used when a ranking applies across the full catalog history -->
    <string name="label_media_rank_timeframe_all_time">All Time</string>

    <!-- Section title for synopsis/description -->
    <string name="label_media_synopsis_section_title">Synopsis</string>
    <!-- Action to expand the synopsis preview and show the full description -->
    <string name="action_media_synopsis_section_show_more">Show more</string>
    <!-- Action to collapse the synopsis back to its preview height -->
    <string name="action_media_synopsis_section_show_less">Show less</string>

    <!-- Media status section -->
    <!-- Section title for anime airing status -->
    <string name="label_media_status_airing_title">Airing Status</string>
    <!-- Section title for manga publishing status -->
    <string name="label_media_status_publishing_title">Publishing Status</string>
    <!-- Action to open the full airing/publication schedule -->
    <string name="label_media_status_show_schedule">Show schedule</string>
    <!-- Displays the volume count: e.g., "Volumes: 12"; %1$d is an integer -->
    <string name="label_volumes_count">Volumes: %1$d</string>

    <!-- Status chip label for currently airing anime -->
    <string name="label_media_status_chip_airing">Airing</string>
    <!-- Status chip label for currently publishing manga -->
    <string name="label_media_status_chip_publishing">Publishing</string>
    <!-- Status chip label for completed series -->
    <string name="label_media_status_chip_completed">Completed</string>
    <!-- Status chip label for unreleased/upcoming series -->
    <string name="label_media_status_chip_not_yet_released">Upcoming</string>
    <!-- Status chip label for cancelled series -->
    <string name="label_media_status_chip_cancelled">Cancelled</string>
    <!-- Status chip label for series on hiatus -->
    <string name="label_media_status_chip_hiatus">On Hiatus</string>

    <!-- Label for next scheduled episode (anime) -->
    <string name="label_media_status_next_episode">Next Episode</string>
    <!-- Label for next scheduled chapter (manga) -->
    <string name="label_media_status_next_chapter">Next Chapter</string>
    <!-- Formatted episode number: e.g., "Episode 5"; %1$d is an integer -->
    <string name="label_media_status_episode_number">Episode %1$d</string>
    <!-- Formatted chapter number: e.g., "Chapter 5"; %1$d is an integer -->
    <string name="label_media_status_chapter_number">Chapter %1$d</string>
    <!-- Placeholder when next manga chapter is unknown; suggests checking external sources -->
    <string name="label_media_status_manga_next_chapter_placeholder">Check online for next chapter</string>
    <!-- Placeholder text when a date is to be determined -->
    <string name="label_media_status_manga_next_chapter_date_placeholder">Date TBD</string>
    <!-- Hiatus title when anime is paused without upcoming episodes -->
    <string name="label_media_status_anime_hiatus_title">Series is currently on hiatus</string>
    <!-- Hiatus subtitle clarifying there are no upcoming episodes -->
    <string name="label_media_status_anime_hiatus_subtitle">No upcoming episodes scheduled</string>
    <!-- Hiatus title when manga is paused without upcoming chapters -->
    <string name="label_media_status_manga_hiatus_title">Manga is currently on hiatus</string>
    <!-- Hiatus subtitle clarifying there are no upcoming chapters -->
    <string name="label_media_status_manga_hiatus_subtitle">No upcoming chapters scheduled</string>
    <!-- Metadata row label for broadcast information (anime) -->
    <string name="label_media_status_broadcast">Broadcast</string>
    <!-- Metadata row label for publication information (manga) -->
    <string name="label_media_status_publication">Publication</string>
    <!-- Fallback text for unknown values in status metadata -->
    <string name="label_media_status_unknown_value">Unknown</string>
    <!-- Metadata label indicating premiere date/season -->
    <string name="label_media_status_premiered">Premiered</string>
    <!-- Metadata label indicating start date -->
    <string name="label_media_status_started">Started</string>
    <!-- Metadata label indicating how many episodes have aired so far -->
    <string name="label_media_status_aired_episodes">Aired episodes</string>
    <!-- Title for the contextual release note shown inside the anime status surface -->
    <string name="label_media_status_timeline_notes_title">Timeline notes</string>
    <!-- Supporting copy for the contextual release note shown inside the anime status surface -->
    <string name="label_media_status_timeline_notes_subtitle">Broadcast shifts, crossover context, and release notes.</string>
    <!-- Metadata label indicating the latest known aired episode -->
    <string name="label_media_status_latest_episode">Latest episode</string>
    <!-- Formatted episode progress: e.g., "8 / 12"; %1$d is the aired count and %2$d is the total count -->
    <string name="label_media_status_episode_progress">%1$d / %2$d</string>
    <!-- Human-readable aired progress summary: e.g., "9 of 12 aired"; %1$d is the aired count and %2$d is the total count -->
    <string name="label_media_status_episode_progress_summary">%1$d of %2$d aired</string>
    <!-- Human-readable aired progress summary when the total episode count is unknown; %1$d is the aired count -->
    <string name="label_media_status_episode_progress_summary_unknown_total">%1$d aired</string>
    <!-- Formatted episode summary with date: e.g., "Episode 8 • Mar 12, 2025"; %1$s is the episode label and %2$s is the formatted date -->
    <string name="label_media_status_episode_with_date">%1$s • %2$s</string>
    <!-- Primary navigation CTA from the media status card into the dedicated episode guide -->
    <string name="action_media_status_episode_guide">Open episode timeline</string>
    <!-- Primary navigation CTA when the episode destination also contains expanded timeline notes -->
    <string name="action_media_status_episode_guide_with_context">Open timeline and notes</string>
    <!-- Small emphasis badge attached to the most recent aired episode -->
    <string name="label_media_episode_badge_latest">Latest</string>
    <!-- Small emphasis badge attached to the next upcoming episode -->
    <string name="label_media_episode_badge_next">Next</string>
    <!-- Episode state badge for already aired episodes -->
    <string name="label_media_episode_state_aired">Aired</string>
    <!-- Episode state badge for scheduled future episodes -->
    <string name="label_media_episode_state_upcoming">Upcoming</string>
    <!-- Episode state badge for episodes with incomplete scheduling metadata -->
    <string name="label_media_episode_state_unknown">Unknown</string>
    <!-- Fallback supporting text when an episode does not expose an air date -->
    <string name="label_media_episode_air_date_unknown">Air date unknown</string>
    <!-- Button text to open full episode schedule -->
    <string name="label_media_status_episode_schedule_button">Episode Schedule</string>
    <!-- Button text to open full publication schedule -->
    <string name="label_media_status_publication_schedule_button">Publication Schedule</string>
</resources>
