{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "schedule": ["every weekend"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "groupName": "io.insert-koin",
      "matchPackageNames": [
        "/^io\\.insert-koin/"
      ]
    }
  ]
}
