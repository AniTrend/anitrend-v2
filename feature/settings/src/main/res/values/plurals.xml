<resources>
    <!-- Summary shown in the log viewer; %d is the number of log entries currently visible -->
    <plurals name="label_settings_log_entry_count">
        <item quantity="one">%1$d entry</item>
        <item quantity="other">%1$d entries</item>
    </plurals>

    <!-- Summary shown on task-state cards; %d is the number of WorkManager jobs in that state -->
    <plurals name="label_settings_task_count">
        <item quantity="one">%1$d task</item>
        <item quantity="other">%1$d tasks</item>
    </plurals>
</resources>
